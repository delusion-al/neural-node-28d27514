---
import Layout from '../layouts/Layout.astro';
---
<Layout title="OPTI-LUXE | Engineering High-Conversion Logic">
  <main class="relative min-h-screen p-4 md:p-8 lg:p-12 space-y-24">
    
    <!-- HERO BENTO SECTION -->
    <section class="grid grid-cols-1 md:grid-cols-4 grid-rows-auto gap-4 max-w-7xl mx-auto">
      <!-- Main Cell: Kinetic Typography -->
      <div class="md:col-span-3 md:row-span-2 glass-card rounded-3xl p-8 md:p-16 flex flex-col justify-center relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-64 h-64 bg-purple-600/20 blur-[120px] rounded-full -mr-32 -mt-32"></div>
        <h1 class="text-5xl md:text-8xl font-black leading-tight tracking-tighter mb-6">
          <span class="kinetic-text block opacity-90">PRECISION</span>
          <span class="glow-text text-transparent bg-clip-text bg-gradient-to-r from-purple-300 to-electric-neon">OPTIMIZATION</span>
          <span class="kinetic-text block opacity-90">LOGIC.</span>
        </h1>
        <p class="text-lg md:text-2xl text-slate-400 max-w-2xl mb-8 font-light">
          We don't just build websites. We engineer digital assets that convert traffic into high-ticket revenue through mathematical UI precision.
        </p>
        <div class="flex gap-4">
          <button class="px-8 py-4 bg-electric-neon text-deep-void font-bold rounded-full hover:scale-105 transition-transform cursor-pointer">
            Get Free Audit
          </button>
          <button class="px-8 py-4 border border-white/20 rounded-full hover:bg-white/10 transition-colors">
            View Case Studies
          </button>
        </div>
      </div>

      <!-- Side Cell: Live Ticker -->
      <div class="glass-card rounded-3xl p-6 flex flex-col justify-between">
        <span class="text-xs uppercase tracking-widest text-slate-500 font-bold">Global Avg. Lift</span>
        <div class="text-4xl font-mono font-bold text-success-glow">
          +142.8% <span class="text-sm">↑</span>
        </div>
        <div class="h-1 w-full bg-white/10 rounded-full overflow-hidden">
          <div class="h-full bg-success-glow w-3/4 animate-pulse"></div>
        </div>
      </div>

      <!-- Bottom Cell: Marquee -->
      <div class="md:col-span-1 glass-card rounded-3xl p-6 flex items-center justify-center overflow-hidden">
        <div class="flex gap-8 animate-marquee whitespace-nowrap opacity-50">
          <span class="font-bold text-xl uppercase">Next.js</span>
          <span class="font-bold text-xl uppercase">Vercel</span>
          <span class="font-bold text-xl uppercase">Stripe</span>
          <span class="font-bold text-xl uppercase">Tailwind</span>
        </div>
      </div>
    </section>

    <!-- LOGIC BENTO SECTION -->
    <section class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-6xl font-bold mb-4">The Logic Ecosystem</h2>
        <p class="text-slate-400">Technical superiority translated into business growth.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Cell A: Speed Slider -->
        <div class="md:col-span-2 glass-card rounded-3xl p-8 relative min-h-[400px] flex flex-col justify-between">
          <div>
            <h3 class="text-2xl font-bold mb-2">Latency Liquidation</h3>
            <p class="text-slate-400">Reducing Time-to-Interactive to sub-500ms.</p>
          </div>
          <div class="relative w-full h-48 bg-white/5 rounded-xl overflow-hidden border border-white/10">
            <div class="absolute inset-0 flex items-center justify-center text-slate-700 font-mono">[BEFORE: 4.2s]</div>
            <div class="absolute inset-y-0 left-0 w-1/2 bg-electric-neon/20 border-r-2 border-electric-neon flex items-center justify-center text-electric-neon font-mono font-bold">
              [AFTER: 0.4s]
            </div>
          </div>
        </div>

        <!-- Cell B: Conversion Lift -->
        <div class="glass-card rounded-3xl p-8 flex flex-col justify-center text-center">
          <div class="text-6xl font-black text-electric-neon mb-4">3.4x</div>
          <p class="text-lg font-medium">Conversion Lift</p>
          <p class="text-sm text-slate-500 mt-2">Average increase across SaaS lead-gen funnels.</p>
        </div>

        <!-- Cell C: Quick Wins -->
        <div class="glass-card rounded-3xl p-8">
          <h3 class="text-xl font-bold mb-6">Core Optimizations</h3>
          <ul class="space-y-4">
            {['LCP Reduction', 'CLS Stabilization', 'Hydration Tuning', 'Edge Caching'].map(item => (
              <li class="flex items-center gap-3 text-slate-300">
                <div class="w-2 h-2 rounded-full bg-success-glow"></div>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Cell D: Engine Preview -->
        <div class="md:col-span-2 glass-card rounded-3xl p-8 flex items-center justify-center bg-gradient-to-br from-purple-900/20 to-transparent">
          <div class="text-center">
            <div class="w-20 h-20 bg-electric-neon rounded-full mx-auto mb-6 animate-bounce flex items-center justify-center">
              <svg class="w-10 h-10 text-deep-void" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /></svg>
            </div>
            <h3 class="text-2xl font-bold">AI-Driven Analysis Engine</h3>
            <p class="text-slate-400">Watch your site be dismantled and rebuilt for profit.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- LEAD GEN SECTION -->
    <section class="max-w-4xl mx-auto text-center py-24">
      <div class="glass-card rounded-[4rem] p-12 md:p-24 relative overflow-hidden">
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-success-glow/20 blur-[100px] rounded-full"></div>
        <h2 class="text-4xl md:text-6xl font-bold mb-8">Ready to scale?</h2>
        <p class="text-xl text-slate-400 mb-12">Enter your URL for a comprehensive glassmorphic logic audit.</p>
        <div class="flex flex-col md:flex-row gap-4 justify-center">
          <input type="text" placeholder="https://your-site.com" class="px-6 py-4 rounded-full bg-white/5 border border-white/10 text-white focus:border-electric-neon outline-none w-full md:w-96" />
          <button class="px-8 py-4 bg-white text-deep-void font-bold rounded-full hover:bg-electric-neon transition-colors cursor-pointer">
            Start Analysis
          </button>
        </div>
      </div>
    </section>

  </main>

  <style>
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .animate-marquee {
      animation: marquee 20s linear infinite;
    }
  </style>
</Layout>