---
import Layout from '../layouts/Layout.astro';
const title = "ApexStructures | Engineering Luxury";
---
<Layout title={title}>
    <main class="relative min-h-screen px-6 py-12 lg:px-24">
        <!-- Kinetic Hero Section -->
        <section class="relative h-[90vh] flex flex-col items-center justify-center text-center overflow-hidden">
            <div class="absolute inset-0 -z-10">
                <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px] animate-pulse"></div>
                <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-yellow-500/10 rounded-full blur-[120px] animate-pulse" style="animation-delay: 2s"></div>
            </div>
            
            <h1 class="text-6xl lg:text-8xl font-['Playfair_Display'] font-bold leading-tight mb-6 opacity-0 translate-y-10 animate-fade-in-up">
                Redefining <span class="text-gradient">Structural</span><br/>Perfection
            </h1>
            <p class="text-gray-400 text-lg lg:text-xl max-w-2xl mb-10 opacity-0 translate-y-10 animate-fade-in-up" style="animation-delay: 0.2s">
                High-end structural improvements for the world's most ambitious architectural projects. Where precision engineering meets timeless luxury.
            </p>
            <div class="flex gap-4 opacity-0 translate-y-10 animate-fade-in-up" style="animation-delay: 0.4s">
                <a href="#contact" class="px-8 py-4 bg-[#D4AF37] text-[#0F172A] font-bold rounded-full hover:scale-105 transition-transform duration-300">
                    Start Your Project
                </a>
                <a href="#work" class="px-8 py-4 glass-card text-white font-semibold rounded-full hover:bg-white/10 transition-all">
                    View Portfolio
                </a>
            </div>
        </section>

        <!-- Bento Grid Features -->
        <section class="py-24 max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-['Playfair_Display'] font-bold mb-4">Engineering Excellence</h2>
                <div class="w-20 h-1 bg-[#D4AF37] mx-auto"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Large Bento Item -->
                <div class="md:col-span-2 md:row-span-2 glass-card p-10 flex flex-col justify-end min-h-[400px] relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-8 opacity-20 group-hover:opacity-40 transition-opacity">
                        <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1">
                            <path d="M3 21h18M3 7l9-4 9 4M4 7v14M20 7v14M12 3v18" />
                        </svg>
                    </div>
                    <h3 class="text-3xl font-bold mb-4">Advanced Load Dynamics</h3>
                    <p class="text-gray-400 max-w-md">Utilizing AI-driven stress analysis to optimize structural integrity while maintaining an ethereal aesthetic.</p>
                </div>

                <!-- Small Bento Item 1 -->
                <div class="glass-card p-8 flex flex-col justify-center">
                    <div class="text-[#D4AF37] mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Eco-Materials</h3>
                    <p class="text-sm text-gray-400">Sustainable, aerospace-grade composites for longevity.</p>
                </div>

                <!-- Small Bento Item 2 -->
                <div class="glass-card p-8 flex flex-col justify-center">
                    <div class="text-[#D4AF37] mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Rapid Deployment</h3>
                    <p class="text-sm text-gray-400">Modular precision for minimized site disruption.</p>
                </div>
            </div>
        </section>

        <!-- Glassmorphic Lead Gen Section -->
        <section id="contact" class="py-24">
            <div class="glass-card max-w-5xl mx-auto p-12 lg:p-20 text-center relative overflow-hidden">
                <div class="absolute -top-24 -left-24 w-64 h-64 bg-[#D4AF37]/20 rounded-full blur-[80px]"></div>
                <h2 class="text-4xl lg:text-5xl font-['Playfair_Display'] font-bold mb-6">Ready to elevate your structure?</h2>
                <p class="text-gray-400 mb-10 max-w-xl mx-auto">Join the elite circle of property owners who prioritize engineering perfection and luxury aesthetics.</p>
                <form class="flex flex-col md:flex-row gap-4 justify-center">
                    <input type="email" placeholder="Enter your professional email" class="px-6 py-4 rounded-full bg-white/5 border border-white/10 focus:border-[#D4AF37] outline-none w-full md:w-96 transition-all" />
                    <button class="px-8 py-4 bg-[#D4AF37] text-[#0F172A] font-bold rounded-full hover:bg-yellow-500 transition-colors">
                        Request Consultation
                    </button>
                </form>
            </div>
        </section>
    </main>

    <style>
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-up {
            animation: fadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }
    </style>
</Layout>